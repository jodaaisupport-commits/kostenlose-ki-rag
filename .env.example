# Kopiere diese Datei zu .env und trage deine kostenlosen API-Keys ein.
# Die Keys können auch direkt im UI eingegeben werden.

# Groq (kostenlos): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (kostenlos): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: Port für den Gradio-Server
PORT=7860
