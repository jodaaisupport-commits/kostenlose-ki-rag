<?xml version="1.0" encoding="utf-8"?>
<!--
    Erzwingt HTTPS für alle Netzwerkverbindungen (Groq/Gemini-APIs laufen
    ausschließlich über TLS). Kein Klartext-Traffic erlaubt.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
